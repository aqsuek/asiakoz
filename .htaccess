RewriteRule ^perimetriya\-almaty/?$ /diagnostika-almaty/ [L,R=301]
RewriteRule ^tonometriya\-almaty/?$ /diagnostika-almaty/ [L,R=301]
RewriteRule ^gonioskopiya\-almaty/?$ /diagnostika-almaty/ [L,R=301]
