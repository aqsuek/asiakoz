RewriteRule ^vspyshki\-v\-glazah\-almaty/?$ /srochnye-simptomy-glaz-almaty/ [L,R=301]
RewriteRule ^mushki\-pered\-glazami\-almaty/?$ /srochnye-simptomy-glaz-almaty/ [L,R=301]
RewriteRule ^pelena\-pered\-glazom\-almaty/?$ /srochnye-simptomy-glaz-almaty/ [L,R=301]
